# Database Configuration
DB_USERNAME=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pabf

# JWT Configuration (Ganti dengan string acak aman di production)
JWT_SECRET_KEY=ganti_dengan_kunci_rahasia_jwt_minimal_32_karakter
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Upload Folder Configuration
UPLOAD_FOLDER=uploads
IZIN_UPLOAD_FOLDER=private_uploads/izin
IZIN_MAX_FILE_BYTES=5242880

# Aturan Bisnis Izin (Hari)
IZIN_MAX_DURASI_HARI=14
IZIN_MAKS_MUNDUR_HARI=3
IZIN_MAKS_MAJU_HARI=60

# Rate Limiter Login
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# GPS & Geofence
MAX_GPS_ACCURACY_METERS=50
GEOFENCE_CENTER_LATITUDE=-0.9147
GEOFENCE_CENTER_LONGITUDE=100.4583
GEOFENCE_RADIUS_METERS=250

# Flask Server Config
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
